# ============================================
# Multi-stage Dockerfile для React микрофронтенда
# ============================================

# ============================================
# ЭТАП 1: Builder (Сборка приложения)
# ============================================
FROM node:18-alpine AS builder

# Установка рабочей директории
WORKDIR /app

# Копирование файлов зависимостей
# Это делается отдельно для кеширования слоя Docker
COPY package*.json ./

# Установка всех зависимостей (включая dev)
# npm ci быстрее и надежнее чем npm install
RUN npm ci

# Копирование всего исходного кода
COPY . .

# Сборка production-версии приложения
# Результат будет в папке /app/build
RUN npm run build.prod

# ============================================
# ЭТАП 2: Production (Финальный образ)
# ============================================
FROM nginx:alpine

# Копирование собранных файлов из builder stage
# nginx по умолчанию ищет файлы в /usr/share/nginx/html
COPY --from=builder /app/build /usr/share/nginx/html

# Копирование кастомной конфигурации nginx (опционально)
# Если у вас есть nginx.conf, раскомментируйте следующую строку:
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Открытие порта 80 (стандартный порт для HTTP)
EXPOSE 80

# nginx запускается автоматически при старте контейнера
# CMD уже определен в базовом образе nginx:alpine

# ============================================
# Комментарии:
# ============================================
# 1. Multi-stage build позволяет создать маленький финальный образ
#    (только nginx + собранные файлы, без node_modules)
#
# 2. Alpine Linux - минималистичный образ Linux (~5MB)
#
# 3. npm ci - устанавливает зависимости точно по package-lock.json
#    Быстрее и надежнее для CI/CD
#
# 4. Порты:
#    - 80 - HTTP (внутри контейнера)
#    - При запуске: docker run -p 3001:80 ...
#      Это маппит порт 3001 хоста на порт 80 контейнера
#
# 5. Для разработки используйте docker-compose.yml
#    Для продакшна используйте этот Dockerfile

