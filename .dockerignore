# ============================================
# .dockerignore - файлы, которые НЕ копируются в Docker-образ
# ============================================
# Это ускоряет сборку и уменьшает размер образа

# Зависимости (будут установлены заново в контейнере)
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Собранные файлы (будут собраны в контейнере)
build
dist

# Git
.git
.gitignore
.gitattributes

# CI/CD файлы (не нужны в образе)
.github
.gitlab-ci.yml

# IDE и редакторы
.vscode
.idea
*.swp
*.swo
*~

# ОС файлы
.DS_Store
Thumbs.db

# Документация
README.md
*.md
docs

# Тесты и покрытие
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Временные файлы
*.log
*.tmp
.cache

# Переменные окружения (если есть)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker файлы (не нужны внутри образа)
Dockerfile
.dockerignore
docker-compose.yml

